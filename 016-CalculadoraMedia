const readline = require("readline");

const rl = readline.createInterface({
  input: process.stdin,
  output: process.stdout,
});

function Validacao(nota) {
  if ((nota) => 7) {
    return "Aprovado";
  } else if ((nota) => 5) {
    return "Recuperação";
  } else {
    return "Reprovado";
  }
}
rl.question("Qual nota do aluno?", function (notaInput) {
  let entradaNota = parseFloat(notaInput);

  if (isNaN(entradaNota) || entradaNota < 0 || entradaNota > 10) {
    console.log("Nota invalida");
    rl.close();
    return;
  }
  let resultado = Validacao(entradaNota);
  console.log(`O aluno esta ${resultado}.`);
  rl.close();
});
